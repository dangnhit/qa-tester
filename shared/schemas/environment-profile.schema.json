{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigentix.dev/qa-skills/schemas/environment-profile.schema.json",
  "title": "Environment Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "producerVersion", "environmentProfileId", "name", "classification", "baseUrl", "productionReadOnly"],
  "properties": {
    "artifactType": { "const": "environment-profile" },
    "schemaVersion": { "const": "1.0.0" },
    "producerVersion": { "type": "string", "minLength": 1 },
    "environmentProfileId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "classification": { "enum": ["local", "test", "staging", "production"] },
    "baseUrl": { "type": "string", "format": "uri" },
    "productionReadOnly": { "type": "boolean" }
  }
}
