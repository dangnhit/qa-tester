{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dangnhit.github.io/qa-tester/schemas/test-result.schema.json",
  "title": "Test Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "producerVersion", "attemptId", "runId", "testCaseId", "testCaseRevisionId", "testCaseInstanceId", "status", "failureClassification", "observedEngine", "steps", "startedAt", "finishedAt"],
  "properties": {
    "artifactType": { "const": "test-result" },
    "schemaVersion": { "const": "3.0.0" },
    "producerVersion": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "testCaseId": { "type": "string", "minLength": 1, "pattern": "^[^:]+$" },
    "testCaseRevisionId": { "type": "string", "minLength": 1, "pattern": "^[^:]+$" },
    "testCaseInstanceId": { "type": "string", "minLength": 1, "pattern": "^[^:]+$" },
    "status": { "enum": ["PASSED", "FAILED", "BLOCKED", "INCONCLUSIVE", "NOT_RUN"] },
    "failureClassification": { "enum": ["PRODUCT_DEFECT", "TEST_DEFECT", "ENVIRONMENT_DEFECT", "UNDETERMINED", "NONE"] },
    "observedEngine": {
      "description": "The browser engine the QA Runtime OBSERVED while driving this attempt, read from the live browser handle. A Browser Matrix member is credited from this value and never from the engine a test case declared (CONTEXT.md:442). Deliberately a free non-empty string rather than an enum: Playwright types BrowserType.name() as string, coverage-obligation.browser is a free string too, and lane 2 reports engines from an external runner this repo does not enumerate. An unrecognized engine matches no obligation, which is already fail-closed; rejecting an honest observation is not.",
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepId", "status", "durationMs"],
        "properties": {
          "stepId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASSED", "FAILED", "BLOCKED", "INCONCLUSIVE", "NOT_RUN"] },
          "durationMs": { "type": "number", "minimum": 0 },
          "failureOrigin": { "enum": ["action", "assertion"] },
          "expectedResultId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" }
  }
}
