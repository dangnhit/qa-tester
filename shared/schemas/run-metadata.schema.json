{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigentix.dev/qa-skills/schemas/run-metadata.schema.json",
  "title": "QA Run Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "producerVersion", "runId", "status", "createdAt", "mode", "environmentProfileId"],
  "properties": {
    "artifactType": { "const": "run-metadata" },
    "schemaVersion": { "const": "1.0.0" },
    "producerVersion": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$" },
    "status": { "enum": ["CREATED", "RUNNING", "FINALIZING", "COMPLETED", "COMPLETED_WITH_FAILURES", "BLOCKED", "ABORTED"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["plan", "execute", "full", "exploratory", "retest", "regression", "cleanup"] },
    "environmentProfileId": { "type": "string", "minLength": 1 },
    "finalizedProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "enum": ["plan", "execute", "full", "exploratory", "retest", "regression", "cleanup"] },
        "version": { "const": "1.0.0" }
      }
    },
    "linkedRunId": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["COMPLETED", "COMPLETED_WITH_FAILURES", "BLOCKED", "ABORTED"] }
        },
        "required": ["status"]
      },
      "then": {
        "properties": { "finalizedProfile": true },
        "required": ["finalizedProfile"]
      },
      "else": {
        "properties": { "finalizedProfile": false }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "plan" } }, "required": ["mode"] },
      "then": { "properties": { "finalizedProfile": { "type": "object", "properties": { "name": { "const": "plan" } } } } }
    },
    {
      "if": { "properties": { "mode": { "const": "execute" } }, "required": ["mode"] },
      "then": { "properties": { "finalizedProfile": { "type": "object", "properties": { "name": { "const": "execute" } } } } }
    },
    {
      "if": { "properties": { "mode": { "const": "full" } }, "required": ["mode"] },
      "then": { "properties": { "finalizedProfile": { "type": "object", "properties": { "name": { "const": "full" } } } } }
    },
    {
      "if": { "properties": { "mode": { "const": "exploratory" } }, "required": ["mode"] },
      "then": { "properties": { "finalizedProfile": { "type": "object", "properties": { "name": { "const": "exploratory" } } } } }
    },
    {
      "if": { "properties": { "mode": { "const": "retest" } }, "required": ["mode"] },
      "then": { "properties": { "finalizedProfile": { "type": "object", "properties": { "name": { "const": "retest" } } } } }
    },
    {
      "if": { "properties": { "mode": { "const": "regression" } }, "required": ["mode"] },
      "then": { "properties": { "finalizedProfile": { "type": "object", "properties": { "name": { "const": "regression" } } } } }
    },
    {
      "if": { "properties": { "mode": { "const": "cleanup" } }, "required": ["mode"] },
      "then": { "properties": { "finalizedProfile": { "type": "object", "properties": { "name": { "const": "cleanup" } } } } }
    }
  ]
}
