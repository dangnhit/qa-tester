{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dangnhit.github.io/qa-tester/schemas/retest-result.schema.json",
  "title": "Retest Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "producerVersion", "runId", "sourceRunId", "sourceBugArtifactId", "sourceBugArtifactSha256", "bugId", "reproductionAttemptIds", "reproductionScenarios", "regressionAttemptIds", "regressionOutcome", "verdict"],
  "properties": {
    "artifactType": { "const": "retest-result" }, "schemaVersion": { "const": "1.0.0" }, "producerVersion": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 }, "sourceRunId": { "type": "string", "minLength": 1 }, "sourceBugArtifactId": { "type": "string", "minLength": 1 }, "sourceBugArtifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bugId": { "type": "string", "minLength": 1 },
    "reproductionAttemptIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "reproductionScenarios": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["scenarioId", "sourceAttemptArtifactId", "sourceTestCaseArtifactId", "attemptId", "status"], "properties": { "scenarioId": { "type": "string", "minLength": 1 }, "sourceAttemptArtifactId": { "type": "string", "minLength": 1 }, "sourceTestCaseArtifactId": { "type": "string", "minLength": 1 }, "attemptId": { "type": "string", "minLength": 1 }, "status": { "enum": ["PASSED", "FAILED", "BLOCKED", "INCONCLUSIVE", "NOT_RUN"] } } } },
    "regressionAttemptIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "verdict": { "enum": ["FIXED", "NOT_FIXED", "PARTIALLY_FIXED", "CANNOT_VERIFY", "INTERMITTENT"] }, "regressionOutcome": { "enum": ["PASSED", "FAILED", "BLOCKED", "INCONCLUSIVE", "NOT_RUN"] }
  }
}
