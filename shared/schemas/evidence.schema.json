{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigentix.dev/qa-skills/schemas/evidence.schema.json",
  "title": "Evidence Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "producerVersion", "evidenceId", "runId", "subject", "kind", "capturedAt", "sha256", "relativePath", "mediaType", "binaryArtifactIds", "binaryArtifacts", "provenance"],
  "properties": {
    "artifactType": { "const": "evidence" },
    "schemaVersion": { "const": "3.0.0" },
    "producerVersion": { "type": "string", "minLength": 1 },
    "evidenceId": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "runId": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object",
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "attemptId", "testCaseId", "testCaseRevisionId", "testCaseInstanceId"], "properties": { "kind": { "const": "attempt" }, "attemptId": { "type": "string", "minLength": 1 }, "testCaseId": { "type": "string", "minLength": 1 }, "testCaseRevisionId": { "type": "string", "minLength": 1 }, "testCaseInstanceId": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "executionId"], "properties": { "kind": { "const": "observed-execution" }, "executionId": { "type": "string", "minLength": 1 } } }
      ]
    },
    "kind": { "enum": ["screenshot", "trace", "console", "network", "log", "runner-report", "evidence-gap"] },
    "capturedAt": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
    "mediaType": { "type": "string", "minLength": 1 },
    "binaryArtifactIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "binaryArtifacts": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "relativePath", "sha256", "mediaType"], "properties": { "id": { "type": "string", "minLength": 1 }, "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "mediaType": { "type": "string", "minLength": 1 } } } },
    "telemetryFindings": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "level", "message"], "properties": { "kind": { "enum": ["console", "network"] }, "level": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 } } } },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceEvidenceArtifactId", "sourceEvidenceSha256", "sourceBinaryArtifactId", "sourceRawSha256"],
      "properties": {
        "sourceEvidenceArtifactId": { "type": "string", "minLength": 1 },
        "sourceEvidenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceBinaryArtifactId": { "type": "string", "minLength": 1 },
        "sourceRawSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "provenance": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["captureType", "dimensions", "dpr", "scroll", "clip", "url", "viewport", "browser", "build", "capturedAt"],
          "properties": {
            "captureType": { "const": "screenshot" },
            "dimensions": { "$ref": "#/$defs/viewport" },
            "dpr": { "type": "number", "exclusiveMinimum": 0 },
            "scroll": { "$ref": "#/$defs/point" },
            "clip": { "$ref": "#/$defs/box" },
            "cssBoxes": { "type": "array", "items": { "$ref": "#/$defs/box" } },
            "pixelBoxes": { "type": "array", "items": { "$ref": "#/$defs/box" } },
            "locator": { "type": "string" },
            "annotationLabels": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "url": { "type": "string" },
            "viewport": { "$ref": "#/$defs/viewport" },
            "browser": { "type": "string", "minLength": 1 },
            "build": { "type": "string", "minLength": 1 },
            "capturedAt": { "type": "string", "format": "date-time" },
            "testcaseId": { "type": "string" },
            "bugId": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["captureType", "url", "browser", "build", "capturedAt"],
          "properties": {
            "captureType": { "enum": ["trace", "console", "network", "log"] },
            "url": { "type": "string" },
            "viewport": { "$ref": "#/$defs/viewport" },
            "browser": { "type": "string", "minLength": 1 },
            "build": { "type": "string", "minLength": 1 },
            "capturedAt": { "type": "string", "format": "date-time" },
            "testcaseId": { "type": "string" },
            "bugId": { "type": "string" }
          }
        },
        {
          "description": "A Runtime-Observed Execution's runner report (lane 2). One raw report covers a whole external suite run, so it measures no page and visits no single URL: the two branches above hard-require url/browser/build, which a reporter payload simply does not have, and reusing one of them would mean inventing all three. Fabricating provenance to satisfy a schema is the failure this contract exists to prevent. Records only what the runtime OBSERVED about the process. There is deliberately NO command/argv field: lane 2's arguments come from the caller and can carry a resolved token or password, CONTEXT.md:371 forbids resolved secret values in artifacts, and an immutable checksummed artifact is the worst possible place to discover one — do not add it back. There is no signal field either, and the producer that writes this branch refuses rather than needing one: src/observed/run-playwright.ts refuses a runner killed by a signal, and refuses a runner Node killed for outgrowing the runtime's output ceiling, because a process cut short produced no trustworthy result and recording it would assert a result nobody observed. This branch is deliberately given no field able to describe a half-execution, so that refusal is structural rather than a choice the producer could revisit — a producer that wanted to record one would have nowhere to put it. What the fields here DO record is what the runtime itself observed about the process; the report those fields describe is written by the process being observed, and src/operations/execute-observed-playwright.ts states what that does and does not prove.",
          "type": "object",
          "additionalProperties": false,
          "required": ["captureType", "runner", "runnerVersion", "exitCode", "capturedAt"],
          "properties": {
            "captureType": { "const": "runner-report" },
            "runner": { "description": "The external runner the runtime spawned and observed, e.g. \"playwright\".", "type": "string", "minLength": 1 },
            "runnerVersion": { "description": "The runner's own reported version, so the report's shape is auditable against the tool that wrote it.", "type": "string", "minLength": 1 },
            "exitCode": { "description": "The process exit code the runtime observed. An integer, including 0 — a fully passing observed execution is still evidenceable.", "type": "integer" },
            "capturedAt": { "type": "string", "format": "date-time" }
          }
        }
      ]
    }
  },
  "$defs": {
    "point": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 } } },
    "box": { "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } } },
    "viewport": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } }
  }
}
