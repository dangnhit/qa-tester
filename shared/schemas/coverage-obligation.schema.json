{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigentix.dev/qa-skills/schemas/coverage-obligation.schema.json",
  "title": "Coverage Obligation",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "producerVersion", "obligationId", "requirementId", "requirementAnalysisArtifactId", "role", "behavior", "executionSurface", "accessibilityMethod", "risk", "required", "outcome"],
  "properties": {
    "artifactType": { "const": "coverage-obligation" },
    "schemaVersion": { "const": "4.0.0" },
    "producerVersion": { "type": "string", "minLength": 1 },
    "obligationId": { "type": "string", "minLength": 1, "pattern": "^[^:]+$" },
    "requirementId": { "type": "string", "minLength": 1 },
    "requirementAnalysisArtifactId": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "behavior": { "type": "string", "minLength": 1 },
    "executionSurface": { "enum": ["browser", "api", "unit", "integration", "performance", "security", "manual"] },
    "browser": { "type": "string", "minLength": 1 },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "accessibilityMethod": {
      "description": "The accessibility evaluation method this obligation requires, or null when it names none. The four members are exactly CONTEXT.md:437's categories; a free-form label is rejected because an arbitrary string in a checksummed audit record is a claim nothing can check. null is a distinct JSON type rather than a fifth member so that 'no accessibility method declared' can never be mistaken for a declared method matching its own label (CONTEXT.md:439).",
      "enum": ["automated-analysis", "keyboard", "screen-reader", "cognitive-manual", null]
    },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "required": { "type": "boolean" },
    "outcome": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    { "if": { "properties": { "executionSurface": { "const": "browser" } }, "required": ["executionSurface"] }, "then": { "properties": { "browser": {}, "viewport": {} }, "required": ["browser", "viewport"] } },
    { "if": { "properties": { "executionSurface": { "not": { "const": "browser" } } }, "required": ["executionSurface"] }, "then": { "not": { "anyOf": [{ "properties": { "browser": {} }, "required": ["browser"] }, { "properties": { "viewport": {} }, "required": ["viewport"] }] } } }
  ]
}
