{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigentix.dev/qa-skills/schemas/test-plan.schema.json",
  "title": "Test Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "producerVersion", "testPlanId", "testCases"],
  "properties": {
    "artifactType": { "const": "test-plan" },
    "schemaVersion": { "const": "1.0.0" },
    "producerVersion": { "type": "string", "minLength": 1 },
    "testPlanId": { "type": "string", "minLength": 1 },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["testCaseId", "title", "expectedResults", "steps", "dslValid", "openQuestions"],
        "properties": {
          "testCaseId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "expectedResults": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "requirementId", "authority", "text"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "requirementId": { "type": "string", "minLength": 1 },
                "authority": { "enum": ["AUTHORITATIVE", "INFERRED", "ASSUMED", "CONFLICTING"] },
                "text": { "type": "string", "minLength": 1 }
              }
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "action", "sideEffect"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "action": { "type": "string", "minLength": 1 },
                "sideEffect": { "enum": ["none", "reversible", "external", "destructive"] },
                "cleanup": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["declared"],
                  "properties": { "declared": { "type": "boolean" } }
                }
              }
            }
          },
          "dslValid": { "type": "boolean" },
          "openQuestions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
