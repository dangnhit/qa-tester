{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dangnhit.github.io/qa-tester/schemas/test-plan.schema.json",
  "title": "Test Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "producerVersion", "testPlanId", "approvalPolicy", "testCases"],
  "properties": {
    "artifactType": { "const": "test-plan" },
    "schemaVersion": { "const": "1.0.0" },
    "producerVersion": { "type": "string", "minLength": 1 },
    "testPlanId": { "type": "string", "minLength": 1 },
    "approvalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "enum": ["auto-approve-safe", "human-review"] } }
    },
    "approvalDecision": {
      "type": "object", "additionalProperties": false,
      "required": ["approved", "mode", "reasons"],
      "properties": {
        "approved": { "type": "boolean" },
        "mode": { "enum": ["AUTO_APPROVED", "HUMAN_REVIEW"] },
        "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["testCaseId", "title", "expectedResults", "steps", "openQuestions"],
        "properties": {
          "testCaseId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "expectedResults": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "requirementId", "authority", "text"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "requirementId": { "type": "string", "minLength": 1 },
                "authority": { "enum": ["AUTHORITATIVE", "INFERRED", "ASSUMED", "CONFLICTING"] },
                "text": { "type": "string", "minLength": 1 }
              }
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "action", "sideEffect"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "action": { "$ref": "#/$defs/action" },
                "sideEffect": { "enum": ["none", "reversible", "external", "destructive"] },
                "cleanup": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["declared"],
                  "properties": { "declared": { "type": "boolean" } }
                }
              }
            }
          },
          "openQuestions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "browserExecution": {
            "type": "object", "additionalProperties": false,
            "required": ["revisionId", "instanceId", "browserDsl", "browserDslFingerprint"],
            "properties": {
              "revisionId": { "type": "string", "minLength": 1 },
              "instanceId": { "type": "string", "minLength": 1 },
              "browserDsl": { "type": "object" },
              "browserDslFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url"],
          "properties": { "kind": { "const": "navigate" }, "url": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "locator"],
          "properties": { "kind": { "const": "click" }, "locator": { "$ref": "#/$defs/locator" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "locator", "value"],
          "properties": { "kind": { "const": "fill" }, "locator": { "$ref": "#/$defs/locator" }, "value": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "locator", "text"],
          "properties": { "kind": { "const": "assert-text" }, "locator": { "$ref": "#/$defs/locator" }, "text": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": { "role": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["testId"],
          "properties": { "testId": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label"],
          "properties": { "label": { "type": "string", "minLength": 1 } }
        }
      ]
    }
  }
}
