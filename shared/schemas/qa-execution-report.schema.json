{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dangnhit.github.io/qa-tester/schemas/qa-execution-report.schema.json",
  "title": "QA Execution Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "producerVersion", "runId", "generatedAt", "build", "summary", "coverageMethods", "incidents", "bugs", "telemetryFindings", "evidenceGaps", "cleanupLeaks", "criticalFindings", "remainingRisks", "excludedNotRun", "releaseGate", "releaseRecommendation"],
  "properties": {
    "artifactType": { "const": "qa-execution-report" }, "schemaVersion": { "const": "1.0.0" }, "producerVersion": { "type": "string", "minLength": 1 }, "runId": { "type": "string", "minLength": 1 }, "generatedAt": { "type": "string", "format": "date-time" },
    "build": { "type": "object", "additionalProperties": false, "required": ["identifier"], "properties": { "identifier": { "type": "string", "minLength": 1 } } }, "summary": { "type": "string", "minLength": 1 },
    "coverageMethods": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "incidents": { "type": "array", "items": { "type": "object" } }, "bugs": { "type": "array", "items": { "type": "object" } }, "telemetryFindings": { "type": "array", "items": { "type": "object" } }, "evidenceGaps": { "type": "array", "items": { "type": "object" } }, "cleanupLeaks": { "type": "array", "items": { "type": "object" } },
    "criticalFindings": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "remainingRisks": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "excludedNotRun": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "protectedEnvironment": { "type": "boolean" },
    "releaseGate": { "type": "object", "additionalProperties": false, "required": ["sourceArtifacts", "recommendation", "ruleInputs", "verdicts"], "properties": { "sourceArtifacts": { "type": "array", "items": { "type": "object" } }, "recommendation": { "enum": ["READY", "READY_WITH_RISKS", "NOT_READY"] }, "protectedEnvironment": { "type": "boolean" }, "ruleInputs": { "type": "object" }, "verdicts": { "type": "array", "items": { "type": "object" } } } }, "releaseRecommendation": { "enum": ["READY", "READY_WITH_RISKS", "NOT_READY"] }
  }
}
