{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigentix.dev/qa-skills/schemas/test-result-batch.schema.json",
  "title": "Test Result Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "producerVersion", "executionId", "runId", "commitSha", "specTreeSha256", "startedAt", "finishedAt", "entries"],
  "properties": {
    "artifactType": { "const": "test-result-batch" },
    "schemaVersion": { "const": "2.0.0" },
    "producerVersion": { "type": "string", "minLength": 1 },
    "executionId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "specTreeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entryId", "testCaseId", "testCaseRevisionId", "testCaseInstanceId", "status", "failureClassification", "observedEngine", "steps"],
        "properties": {
          "entryId": { "type": "string", "minLength": 1 },
          "testCaseId": { "type": "string", "minLength": 1 },
          "testCaseRevisionId": { "type": "string", "minLength": 1 },
          "testCaseInstanceId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASSED", "FAILED", "BLOCKED", "INCONCLUSIVE", "NOT_RUN"] },
          "failureClassification": { "enum": ["PRODUCT_DEFECT", "TEST_DEFECT", "ENVIRONMENT_DEFECT", "UNDETERMINED", "NONE"] },
          "observedEngine": {
            "description": "The browser engine the observed execution reported for this entry. Same shape and same rule as test-result.observedEngine (CONTEXT.md:442): coverage is credited from the engine that ran, never from the one a test case declared. This artifact has no producer yet — Phase 7 owns it — so the field is required from the start rather than retrofitted onto existing instances.",
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stepId", "status", "durationMs"],
              "properties": {
                "stepId": { "type": "string", "minLength": 1 },
                "status": { "enum": ["PASSED", "FAILED", "BLOCKED", "INCONCLUSIVE", "NOT_RUN"] },
                "durationMs": { "type": "number", "minimum": 0 },
                "failureOrigin": { "enum": ["action", "assertion"] },
                "expectedResultId": { "type": "string", "minLength": 1 }
              }
            }
          },
          "evidenceArtifactIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
