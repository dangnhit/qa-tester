{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigentix.dev/qa-skills/schemas/regression-selection.schema.json",
  "title": "Regression Selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "producerVersion", "selectionId", "runId", "selected", "excluded", "unmappedChangeRisks", "complete"],
  "properties": {
    "artifactType": { "const": "regression-selection" }, "schemaVersion": { "const": "1.0.0" }, "producerVersion": { "type": "string", "minLength": 1 }, "selectionId": { "type": "string", "minLength": 1 }, "runId": { "type": "string", "minLength": 1 },
    "selected": { "type": "array", "items": { "$ref": "#/$defs/decision" } }, "excluded": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "unmappedChangeRisks": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["changeId", "rationale", "confidence"], "properties": { "changeId": { "type": "string", "minLength": 1 }, "rationale": { "type": "string", "minLength": 1 }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 } } } }, "complete": { "type": "boolean" }
  },
  "$defs": { "decision": { "type": "object", "additionalProperties": false, "required": ["testCaseId", "revisionId", "source", "rationale", "confidence"], "properties": { "testCaseId": { "type": "string", "minLength": 1 }, "revisionId": { "type": "string", "minLength": 1 }, "source": { "enum": ["requirement-mapping", "code-surface-mapping", "declared-dependency", "git-diff-heuristic", "user-scope"] }, "rationale": { "type": "string", "minLength": 1 }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 } } } }
}
