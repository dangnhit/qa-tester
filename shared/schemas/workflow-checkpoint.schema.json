{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigentix.dev/qa-skills/schemas/workflow-checkpoint.schema.json",
  "title": "Workflow Checkpoint",
  "type": "object", "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "producerVersion", "checkpointId", "runId", "mode", "inputChecksum", "revision", "completedOperations", "operationOutputs", "state", "stateChecksum"],
  "properties": {
    "artifactType": { "const": "workflow-checkpoint" }, "schemaVersion": { "const": "1.0.0" }, "producerVersion": { "type": "string", "minLength": 1 },
    "checkpointId": { "type": "string", "minLength": 1 }, "runId": { "type": "string", "minLength": 1 }, "mode": { "enum": ["plan", "execute", "full", "exploratory", "retest", "regression"] },
    "inputChecksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "stateChecksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "revision": { "type": "integer", "minimum": 1 }, "supersedesArtifactId": { "type": "string", "minLength": 1 }, "completedOperations": { "type": "array", "uniqueItems": true, "items": { "enum": ["ingest-requirement-analysis", "ingest-testcases", "ingest-coverage-obligation", "prepare-test-data", "execute-browser-test", "collect-evidence", "generate-bug-report", "generate-qa-report", "register-exploration-charter", "reproduce-bug", "select-regression", "derive-retest-verdict"] } }, "operationOutputs": { "type": "object", "propertyNames": { "enum": ["ingest-requirement-analysis", "ingest-testcases", "ingest-coverage-obligation", "prepare-test-data", "execute-browser-test", "collect-evidence", "generate-bug-report", "generate-qa-report", "register-exploration-charter", "reproduce-bug", "select-regression", "derive-retest-verdict"] }, "additionalProperties": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["artifactId", "sha256"], "properties": { "artifactId": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } } },
    "bundle": { "type": "object", "additionalProperties": false, "required": ["sourceRunId", "artifacts"], "properties": { "sourceRunId": { "type": "string", "minLength": 1 }, "artifacts": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["artifactId", "sha256"], "properties": { "artifactId": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } } } },
    "state": { "type": "object", "additionalProperties": false, "required": ["importedArtifacts", "executionCases", "reproductionAttempts", "regressionAttempts", "exploratoryFindings"], "properties": { "importedArtifacts": { "$ref": "#/$defs/refs" }, "executionCases": { "$ref": "#/$defs/refs" }, "reproductionAttempts": { "$ref": "#/$defs/refs" }, "regressionAttempts": { "$ref": "#/$defs/refs" }, "exploratoryFindings": { "$ref": "#/$defs/refs" }, "selection": { "$ref": "#/$defs/ref" }, "charter": { "$ref": "#/$defs/ref" }, "retestSource": { "type": "object" } } }
  },
  "$defs": {
    "ref": { "type": "object", "additionalProperties": false, "required": ["artifactId", "sha256"], "properties": { "artifactId": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
  }
}
