{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigentix.dev/qa-skills/schemas/test-case.schema.json",
  "title": "Test Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "producerVersion", "testCaseId", "revisionId", "instanceId", "title", "steps", "coverage"],
  "properties": {
    "artifactType": { "const": "test-case" },
    "schemaVersion": { "const": "1.0.0" },
    "producerVersion": { "type": "string", "minLength": 1 },
    "testCaseId": { "type": "string", "minLength": 1 },
    "revisionId": { "type": "string", "minLength": 1 },
    "instanceId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["testPlanArtifactId", "browserDsl"],
      "properties": {
        "testPlanArtifactId": { "type": "string", "minLength": 1 },
        "browserDsl": { "type": "object" }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "sideEffect"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "sideEffect": { "enum": ["none", "reversible", "external", "destructive"] }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "role", "behavior", "browser", "viewport", "accessibilityMethod", "risk", "outcome"],
      "properties": {
        "requirementId": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "behavior": { "type": "string", "minLength": 1 },
        "browser": { "type": "string", "minLength": 1 },
        "viewport": {
          "type": "object", "additionalProperties": false, "required": ["width", "height"],
          "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
        },
        "accessibilityMethod": { "type": ["string", "null"] },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "outcome": { "type": "string", "minLength": 1 }
      }
    }
  }
}
