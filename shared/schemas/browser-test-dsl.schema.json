{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigentix.dev/qa-skills/schemas/browser-test-dsl.schema.json",
  "title": "Browser Test DSL",
  "type": "object",
  "additionalProperties": false,
  "required": ["steps"],
  "properties": { "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } } },
  "$defs": {
    "value": { "oneOf": [{ "type": "string" }, { "type": "object", "additionalProperties": false, "required": ["secretRef"], "properties": { "secretRef": { "type": "string", "minLength": 1 } } }] },
    "locator": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["role"], "properties": { "role": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["testId"], "properties": { "testId": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["label"], "properties": { "label": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["placeholder"], "properties": { "placeholder": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["text"], "properties": { "text": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["css"], "properties": { "css": { "type": "string", "minLength": 1, "not": { "pattern": "^\\s*(?:[Xx][Pp][Aa][Tt][Hh]=|//)" } } } }
    ] },
    "action": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["kind", "url"], "properties": { "kind": { "const": "open" }, "url": { "$ref": "#/$defs/value" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "locator"], "properties": { "kind": { "const": "click" }, "locator": { "$ref": "#/$defs/locator" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "locator", "value"], "properties": { "kind": { "const": "fill" }, "locator": { "$ref": "#/$defs/locator" }, "value": { "$ref": "#/$defs/value" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "locator", "value"], "properties": { "kind": { "const": "select" }, "locator": { "$ref": "#/$defs/locator" }, "value": { "$ref": "#/$defs/value" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "locator"], "properties": { "kind": { "const": "check" }, "locator": { "$ref": "#/$defs/locator" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "locator"], "properties": { "kind": { "const": "uncheck" }, "locator": { "$ref": "#/$defs/locator" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "locator", "key"], "properties": { "kind": { "const": "press" }, "locator": { "$ref": "#/$defs/locator" }, "key": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "locator", "files"], "properties": { "kind": { "const": "upload" }, "locator": { "$ref": "#/$defs/locator" }, "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } },
      { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "wait" }, "milliseconds": { "type": "integer", "minimum": 0 }, "locator": { "$ref": "#/$defs/locator" } } }
    ] },
    "assertion": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["kind", "locator"], "properties": { "kind": { "const": "visible" }, "locator": { "$ref": "#/$defs/locator" }, "expectedResultId": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "locator", "text"], "properties": { "kind": { "const": "text" }, "locator": { "$ref": "#/$defs/locator" }, "text": { "type": "string" }, "expectedResultId": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "locator", "value"], "properties": { "kind": { "const": "value" }, "locator": { "$ref": "#/$defs/locator" }, "value": { "$ref": "#/$defs/value" }, "expectedResultId": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "url"], "properties": { "kind": { "const": "url" }, "url": { "type": "string", "minLength": 1 }, "expectedResultId": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "locator", "count"], "properties": { "kind": { "const": "count" }, "locator": { "$ref": "#/$defs/locator" }, "count": { "type": "integer", "minimum": 0 }, "expectedResultId": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "locator"], "properties": { "kind": { "enum": ["enabled", "disabled", "checked"] }, "locator": { "$ref": "#/$defs/locator" }, "expectedResultId": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "url", "status"], "properties": { "kind": { "const": "response-status" }, "url": { "type": "string", "minLength": 1 }, "status": { "type": "integer", "minimum": 100, "maximum": 599 }, "expectedResultId": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "console-policy" }, "level": { "enum": ["error", "warning"] }, "allow": { "type": "array", "items": { "type": "string" } }, "expectedResultId": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "network-policy" }, "allow": { "type": "array", "items": { "type": "string" } }, "expectedResultId": { "type": "string", "minLength": 1 } } }
    ] },
    "step": { "type": "object", "additionalProperties": false, "required": ["id", "action", "sideEffect"], "properties": { "id": { "type": "string", "minLength": 1 }, "action": { "$ref": "#/$defs/action" }, "assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } }, "sideEffect": { "enum": ["none", "reversible", "external", "destructive"] }, "independent": { "type": "boolean" } }, "allOf": [
      { "if": { "required": ["action"], "properties": { "action": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "upload" } } } } }, "then": { "properties": { "sideEffect": { "enum": ["reversible", "external", "destructive"] } } } }
    ] }
  }
}
