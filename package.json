{
  "name": "@vigentix/qa-skills",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "skills"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/orchestration/qa-tester.d.ts",
      "import": "./dist/src/orchestration/qa-tester.js"
    },
    "./cli": {
      "types": "./dist/src/cli/index.d.ts",
      "import": "./dist/src/cli/index.js"
    }
  },
  "types": "./dist/src/orchestration/qa-tester.d.ts",
  "bin": {
    "qa-skill": "./dist/src/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-assets.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo": "tsx scripts/run-demo.ts",
    "scan:secrets": "tsx scripts/check-secrets.ts",
    "generate:types": "tsx scripts/generate-types.ts",
    "check:generated": "npm run generate:types && git diff --exit-code -- src/contracts/generated",
    "smoke:package": "tsx scripts/smoke-package-consumer.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.54.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.0",
    "sharp": "^0.34.3",
    "ulid": "^3.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.15",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.31.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^3.2.4"
  }
}
